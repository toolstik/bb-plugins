{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "app.tsx",
    "components/**/*.tsx"
  ]
}
